<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sand_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/gradeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/green_primary"
            android:textSize="30sp"
            android:textStyle="bold"
            tools:text="Correct" />

        <TextView
            android:id="@+id/proverbText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Haraka haraka haina baraka" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/result_your_answer"
            android:textColor="@color/ink_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/answerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="17sp"
            tools:text="Hurry hurry has no blessing" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/result_meaning"
            android:textColor="@color/ink_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/meaningText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="17sp"
            tools:text="Haste makes waste" />

        <TextView
            android:id="@+id/keywordsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/ink_muted"
            android:textSize="15sp"
            tools:text="Meaning words matched: haste, waste" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/result_machine_label"
                    android:textColor="@color/ink_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/machineText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    tools:text="Machine literal: haste haste has no blessing" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/machineProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/result_continue"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
