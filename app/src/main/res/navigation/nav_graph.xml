<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.mizizi.ui.home.HomeFragment"
        android:label="@string/title_home">

        <action
            android:id="@+id/action_homeFragment_to_practiceFragment"
            app:destination="@id/practiceFragment" />
    </fragment>

    <fragment
        android:id="@+id/practiceFragment"
        android:name="com.example.mizizi.ui.practice.PracticeFragment"
        android:label="@string/title_practice">

        <action
            android:id="@+id/action_practiceFragment_to_resultFragment"
            app:destination="@id/resultFragment" />
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.example.mizizi.ui.result.ResultFragment"
        android:label="@string/title_result">

        <argument
            android:name="proverbOriginal"
            app:argType="string" />
        <argument
            android:name="meaning"
            app:argType="string" />
        <argument
            android:name="answer"
            app:argType="string" />
        <argument
            android:name="grade"
            app:argType="string" />
        <argument
            android:name="matchedKeywords"
            app:argType="string" />
        <argument
            android:name="sessionFinished"
            app:argType="boolean" />
    </fragment>

</navigation>
